# Токен бота от @BotFather (серверный секрет, НЕ публикуется)
# На Amvera добавить в разделе «Переменные и секреты» (тип: секрет)
TELEGRAM_BOT_TOKEN=

# ID чата, куда приходят заявки (ваш личный ID или ID группы)
# Узнать можно у бота @userinfobot. Добавить в «Переменные» на Amvera
TELEGRAM_CHAT_ID=

# Адрес эндпоинта приёма заявок на фронтенде (обычно не меняется)
VITE_CONTACT_ENDPOINT=/api/contact

# Публичный адрес сайта для SEO (canonical, Open Graph, sitemap).
# Должен заканчиваться на "/". Задаётся на этапе сборки.
# По умолчанию уже стоит продакшн-домен, менять нужно только при смене домена.
# VITE_SITE_URL=https://drgondusov.ru/

# Порт для серверной раздачи (server/index.js), по умолчанию 3000
PORT=3000
